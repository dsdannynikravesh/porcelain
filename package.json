{
  "name": "porcelain",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A fast, polished terminal Git client — status, staging, hunks, branches, stashes, conflicts, and undo, without leaving the keyboard.",
  "license": "MIT",
  "author": "Danny Nikravesh",
  "homepage": "https://github.com/dsdannynikravesh/porcelain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsdannynikravesh/porcelain.git"
  },
  "bugs": {
    "url": "https://github.com/dsdannynikravesh/porcelain/issues"
  },
  "keywords": [
    "git",
    "tui",
    "cli",
    "terminal",
    "opentui"
  ],
  "bin": {
    "porcelain": "./src/index.tsx",
    "por": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bash scripts/build.sh",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.3.0"
  }
}
